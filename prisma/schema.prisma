generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Role {
  CUSTOMER
  PRINTER_OWNER
  ADMIN
}

enum PrinterType {
  FDM
  SLA
  RESIN
}

enum OrderStatus {
  UPLOADED
  QUOTED
  CONFIRMED
  PRINTING
  QUALITY_CHECK
  READY
  DELIVERED
}

enum Material {
  PLA
  ABS
  PETG
  RESIN
}

// ─────────────────────────────────────────────
// CORE MODELS
// ─────────────────────────────────────────────

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  name                String
  passwordHash        String?
  phone               String?   @unique
  phoneVerified       Boolean   @default(false)
  role                Role      @default(CUSTOMER)
  address             String?
  city                String?
  lat                 Float?
  lng                 Float?
  avatarUrl           String?
  // Account lockout
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  // Password reset
  resetToken          String?
  resetTokenExpiry    DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  orders          Order[]       @relation("CustomerOrders")
  printerOwner    PrinterOwner?
  addresses       Address[]
  benefits        UserBenefit[]
  subscription    Subscription?
  paymentEvents   PaymentEvent[]
  savedParts      SavedPart[]
  teamMemberships TeamMember[]

  @@index([email])
  @@index([city])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  label     String
  lineOne   String
  lineTwo   String?
  city      String
  state     String
  pincode   String
  country   String   @default("India")
  lat       Float
  lng       Float
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserBenefit {
  id          String    @id @default(cuid())
  userId      String
  type        String
  description String
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Subscription {
  id                 String    @id @default(cuid())
  userId             String    @unique
  plan               String
  status             String
  razorpaySubId      String?
  stripeSubId        String?
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelledAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PaymentEvent {
  id         String   @id @default(cuid())
  orderId    String?
  userId     String
  type       String
  amount     Float
  currency   String   @default("INR")
  provider   String
  providerId String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([orderId])
}

model PrinterOwner {
  id              String   @id @default(cuid())
  userId          String   @unique
  businessName    String?
  description     String?
  rating          Float    @default(5.0)
  totalRatings    Int      @default(0)
  isActive        Boolean  @default(true)
  isVisible       Boolean  @default(true)
  surgeMultiplier Float    @default(1.0)
  totalEarned     Float    @default(0.0)
  pendingPayout   Float    @default(0.0)
  bankAccount     String?
  bankIfsc        String?
  // Business location (may differ from owner's personal address)
  businessAddress String?
  businessCity    String?
  businessLat     Float?
  businessLng     Float?
  // Services offered: "3d-printer" | "laser-cutter" | "cnc-mill" | etc.
  services        String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  printers Printer[]
  quotes   Quote[]
  ratings  Rating[]

  @@index([isVisible, isActive])
}

model Printer {
  id        String      @id @default(cuid())
  ownerId   String
  name      String
  type      PrinterType
  maxBuildX Float
  maxBuildY Float
  maxBuildZ Float
  materials String[]
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())

  owner PrinterOwner @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

model STLAnalysis {
  id                  String   @id @default(cuid())
  fileName            String
  fileSizeBytes       Int
  volumeCm3           Float
  surfaceAreaCm2      Float
  boundingBoxXMm      Float
  boundingBoxYMm      Float
  boundingBoxZMm      Float
  triangleCount       Int
  estimatedPrintHours Float
  needsSupport        Boolean  @default(false)
  cloudinaryPublicId  String?
  cloudinaryUrl       String?
  createdAt           DateTime @default(now())

  orders Order[]

  @@index([createdAt])
}

model Order {
  id                    String      @id @default(cuid())
  customerId            String
  status                OrderStatus @default(UPLOADED)
  stlAnalysisId         String?
  material              Material    @default(PLA)
  infillDensity         Float       @default(0.30)
  layerHeight           Float       @default(0.20)
  quantity              Int         @default(1)
  estimatedPrice        Float?
  totalPrice            Float?
  city                  String
  lat                   Float
  lng                   Float
  acceptedQuoteId       String?
  completionPhoto       String?
  estimatedCompletionAt DateTime?
  notes                 String?
  // Payment
  razorpayOrderId       String?
  razorpayPaymentId     String?
  stripePaymentId       String?
  paymentStatus         String?     @default("pending")
  platformFee           Float?
  ownerPayout           Float?
  payoutStatus          String?     @default("pending")
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  customer      User                 @relation("CustomerOrders", fields: [customerId], references: [id])
  stlAnalysis   STLAnalysis?         @relation(fields: [stlAnalysisId], references: [id])
  statusHistory OrderStatusHistory[]
  quotes        Quote[]
  rating        Rating?

  @@index([customerId])
  @@index([city, status])
  @@index([status])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  timestamp DateTime    @default(now())
  note      String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Quote {
  id             String   @id @default(cuid())
  orderId        String
  printerOwnerId String
  price          Float
  turnaroundDays Int
  message        String?
  isAccepted     Boolean  @default(false)
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  printerOwner PrinterOwner @relation(fields: [printerOwnerId], references: [id])

  @@index([orderId])
  @@index([printerOwnerId])
}

model Rating {
  id             String   @id @default(cuid())
  orderId        String   @unique
  printerOwnerId String
  printQuality   Int
  accuracy       Int
  packaging      Int
  compositeScore Float
  comment        String?
  createdAt      DateTime @default(now())

  order        Order        @relation(fields: [orderId], references: [id])
  printerOwner PrinterOwner @relation(fields: [printerOwnerId], references: [id])

  @@index([printerOwnerId])
}

// Stores real price datapoints for ML model retraining.
// Tier 1: source="foundry_quote" (real accepted transactions)
// Tier 2: source="jlcpcb_formula" / "3ding_rate_table" / etc. (scraped)
model PriceDataPoint {
  id        String   @id @default(cuid())
  equipment String   // "3d-printer" | "cnc-mill" | "laser-cutter" | etc.
  features  Json     // {"volume_cm3": 42.5, "infill": 0.3, ...}
  priceInr  Float
  source    String   // "foundry_quote" | "jlcpcb_formula" | "indiamart_rate_table" | …
  orderId   String?  // set when source="foundry_quote"
  createdAt DateTime @default(now())

  @@index([equipment, source])
  @@index([createdAt])
}

model DemandMetric {
  id         String   @id @default(cuid())
  city       String
  date       DateTime @db.Date
  orderCount Int      @default(0)

  @@unique([city, date])
  @@index([city, date])
}

// ─────────────────────────────────────────────
// PART LIBRARY
// ─────────────────────────────────────────────

model SavedPart {
  id               String    @id @default(cuid())
  userId           String
  teamId           String?
  name             String
  process          String
  material         String
  estimatedCostInr Float
  notes            String?
  assemblyName     String?
  orderCount       Int       @default(0)
  lastOrderedAt    DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team? @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([teamId])
}

// ─────────────────────────────────────────────
// TEAMSPACE
// ─────────────────────────────────────────────

model Team {
  id          String   @id @default(cuid())
  name        String
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members    TeamMember[]
  savedParts SavedPart[]
  invites    TeamInvite[]
}

model TeamMember {
  id       String    @id @default(cuid())
  teamId   String
  userId   String
  role     String    @default("MEMBER") // "ADMIN" | "MEMBER"
  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@index([userId, leftAt])
}

model TeamInvite {
  id        String   @id @default(cuid())
  teamId    String
  token     String   @unique @default(cuid())
  expiresAt DateTime
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([token])
}
